# port the app listens on (host and container)
PORT=7777
# public URL of your instance, used for links, social cards and CSRF checks.
# The CSRF origin is compiled in at build time, so rebuild after changing it
PUBLIC_URL=http://localhost:7777
# optional: new posts are announced to this Discord webhook
DISCORD_WEBHOOK_URL=
# postgres connection string for running the app outside docker (e.g. bun run dev with docker-compose.dev.yaml).
# docker-compose.yaml builds its own, so this is ignored there
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# password people need to enter to register; registration is closed while this is empty
SIGNUP_PASSWORD=
# header holding the real client IP when behind a proxy, enables per-IP rate limits
# (e.g. CF-Connecting-IP behind Cloudflare, X-Forwarded-For behind caddy/nginx)
ADDRESS_HEADER=
# interface the port is published on; 0.0.0.0 exposes it to the network
BIND_ADDRESS=127.0.0.1
